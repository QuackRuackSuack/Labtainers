# Filename : start.config
# dhcp-starvation lab
#   One bridged LAN.  A dnsmasq DHCP server with a finite address pool,
#   a benign client (crafts DHCP for virtual MACs via Scapy), an attacker
#   (DHCP starvation flood via Scapy), and a passive monitor (pcap capture).
#
#   Static container IPs sit OUTSIDE the DHCP pool so Docker's own address
#   assignment never collides with leases.  MACs are fixed (02:42 + the /24
#   host octet) for reproducible captures.

GLOBAL_SETTINGS

	# Master seed for this lab's per-student parameterization
	LAB_MASTER_SEED dhcp-starvation_student_master_seed

	# Collect the lab/docs directory into the student artifacts
	# COLLECT_DOCS YES

NETWORK LAN
	MASK 192.168.1.0/24
	GATEWAY 192.168.1.101

CONTAINER server
	USER ubuntu
	LAN 192.168.1.2:02:42:c0:a8:01:02

CONTAINER client
	USER ubuntu
	LAN 192.168.1.10:02:42:c0:a8:01:0a

CONTAINER attacker
	USER ubuntu
	LAN 192.168.1.5:02:42:c0:a8:01:05

CONTAINER monitor
	USER ubuntu
	LAN 192.168.1.3:02:42:c0:a8:01:03
